# =========================================================
# DuBaoMatRung - Docker Environment Configuration
# Copy to .env and fill in production values
# =========================================================

# Application
NODE_ENV=production
LOG_LEVEL=info
APP_PORT=3000

# Frontend URL (thay bằng IP server thực tế)
FRONTEND_URL=http://localhost:3000

# Database
DB_PASSWORD=DuBaoMatRung2025SecurePass

# JWT Secrets (THAY BẰNG GIÁ TRỊ BÍ MẬT THỰC TẾ TRONG PRODUCTION!)
JWT_SECRET=dubaomatrung_jwt_secret_production_key_2025_secure_random_string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=dubaomatrung_refresh_jwt_secret_production_key_2025_secure_random_string
REFRESH_TOKEN_EXPIRES_IN=30d

# Exposed ports (thay nếu bị conflict)
POSTGRES_PORT=5432
REDIS_PORT=6379
MONGODB_PORT=27017
