FROM node:18-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends wget && rm -rf /var/lib/apt/lists/*

# Copy workspace package.json files for npm workspace dep resolution
COPY microservices/package.json microservices/package-lock.json* microservices/
COPY microservices/shared/package.json microservices/shared/
COPY microservices/gateway/package.json microservices/gateway/
COPY microservices/services/auth-service/package.json microservices/services/auth-service/
COPY microservices/services/user-service/package.json microservices/services/user-service/
COPY microservices/services/gis-service/package.json microservices/services/gis-service/
COPY microservices/services/report-service/package.json microservices/services/report-service/
COPY microservices/services/admin-service/package.json microservices/services/admin-service/
COPY microservices/services/search-service/package.json microservices/services/search-service/
COPY microservices/services/mapserver-service/package.json microservices/services/mapserver-service/

# Install at workspace level (hoists all deps to microservices/node_modules/)
RUN cd microservices && npm install --omit=dev --ignore-scripts 2>/dev/null || \
    cd microservices && npm install --omit=dev

# Copy shared source
COPY microservices/shared/ microservices/shared/

# Copy gis-service source
COPY microservices/services/gis-service/ microservices/services/gis-service/

RUN mkdir -p /app/uploads

WORKDIR /app/microservices/services/gis-service

EXPOSE 3003

CMD ["node", "src/index.js"]
